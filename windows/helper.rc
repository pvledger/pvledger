#include <windows.h>
#include "resource.h"

IDI_PVLEDGER ICON "pvledger.ico"

IDD_CONFIGURATION DIALOGEX 0, 0, 385, 249
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PVLedger Configuration"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Configuration file", -1, 8, 8, 370, 10
    EDITTEXT IDC_CONFIG_PATH, 8, 20, 369, 14, ES_AUTOHSCROLL | ES_READONLY
    EDITTEXT IDC_YAML, 8, 40, 369, 170, ES_MULTILINE | ES_WANTRETURN | ES_AUTOHSCROLL | ES_AUTOVSCROLL | WS_HSCROLL | WS_VSCROLL
    LTEXT "Saved changes take effect the next time the server starts.", -1, 8, 215, 369, 10
    DEFPUSHBUTTON "OK", IDOK, 211, 228, 52, 14
    PUSHBUTTON "Cancel", IDCANCEL, 268, 228, 52, 14
    PUSHBUTTON "Apply", IDC_APPLY, 325, 228, 52, 14
END
